<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>

<body>

  <%- include('./partials/nav.ejs') %>

  <!-- 404 / No Results Page -->
  <div class="mqt-error-wrapper">
    <div class="mqt-error-card">

      <!-- 1. Top 404 Graphic Badge -->
      <div class="mqt-error-badge-row">
        <span class="mqt-badge-num">404</span>
        <div class="mqt-error-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
      </div>

      <!-- 2. Typography -->
      <h1 class="mqt-error-heading">Page Not Found or No Results</h1>
      <p class="mqt-error-text">
        The page you are looking for does not exist, or no matching AI tools were found. Try searching below or jump into our popular categories.
      </p>

      <!-- 3. Clean Centered Search Bar -->
      <form action="/search" method="GET" class="mqt-error-search-form" role="search">
        <div class="mqt-input-wrap">
          <svg class="mqt-search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" name="q" class="mqt-search-field" placeholder="Search AI tools (e.g. Claude, Cursor, Video)..." aria-label="Search AI tools" autocomplete="off">
        </div>
        <button type="submit" class="mqt-search-submit-btn">Search</button>
      </form>

      <!-- 4. Category Pills -->
      <div class="mqt-categories-box">
        <span class="mqt-cat-title">Explore popular categories:</span>
        <div class="mqt-pills-list">
          <a href="/category/coding" class="mqt-pill">
            <span class="mqt-pill-dot dot-green"></span> Coding
          </a>
          <a href="/category/writing" class="mqt-pill">
            <span class="mqt-pill-dot dot-purple"></span> Writing
          </a>
          <a href="/category/image" class="mqt-pill">
            <span class="mqt-pill-dot dot-pink"></span> Image Generation
          </a>
          <a href="/category/video" class="mqt-pill">
            <span class="mqt-pill-dot dot-orange"></span> Video
          </a>
        </div>
      </div>

      <!-- 5. Bottom Action Buttons -->
      <div class="mqt-error-btn-group">
        <a href="/" class="mqt-btn mqt-btn-primary">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Back to Home</span>
        </a>
      </div>

    </div>
  </div>

  <%- include('./partials/footer.ejs') %>
</body>

</html>